# Neo4j (o docker-compose usa NEO4J_PASSWORD na primeira subida do volume)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphrag-kag-dev
NEO4J_DATABASE=neo4j

# LLM: openai | anthropic | ollama
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.4-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_HOST=http://localhost:11434

# Preço em US$ por 1 milhão de tokens, para estimar custo na avaliação
LLM_PRICE_INPUT_PER_M=0.0
LLM_PRICE_OUTPUT_PER_M=0.0

# Embeddings: sentence-transformers (local, sem custo) | openai
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSIONS=384

# Resolução de entidades
ER_FUZZY_THRESHOLD=92
ER_EMBED_THRESHOLD=0.92

# Recuperação e verificação
RETRIEVAL_TOP_K=6
CYPHER_MAX_LIMIT=50
CYPHER_TIMEOUT_SECONDS=15
MIN_EVIDENCE_SCORE=0.35
